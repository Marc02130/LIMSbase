# Copy to .env and replace the placeholders. .env is not committed.
# Inside Compose, DB_HOST is the mysql service. When SQLALCHEMY_DATABASE_URI
# is unset, config.py builds mysql+pymysql://DB_USER:DB_PASSWORD@mysql:3306/
# and database.py appends DATA_DB_NAME.
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://iggybase:change-me@mysql:3306/

SECRET_KEY=change-me
SECURITY_PASSWORD_SALT=change-me
SECURITY_PASSWORD_HASH=argon2

DB_USER=iggybase
DB_PASSWORD=change-me
DB_HOST=mysql
DB_PORT=3306
DATA_DB_NAME=iggybase
SEMANTIC_DB_NAME=

# Same values as DB_USER, DB_PASSWORD, and DATA_DB_NAME. Compose passes
# these to the mysql image only.
MYSQL_DATABASE=iggybase
MYSQL_USER=iggybase
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

UPLOAD_FOLDER=/var/iggybase/uploads
FILE_FOLDER=/var/iggybase/files
ALLOWED_EXTENSIONS=pdf,csv,png,jpg,jpeg,gif,txt,xls,xlsx

MAIL_SERVER=
MAIL_PORT=25
MAIL_USE_TLS=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Optional Harvard accounting database. Leave both unset to skip it.
# SPINAL_DATABASE_URI=mysql+pymysql://user:change-me@host:3306/
# SPINAL_DB_NAME=spinal
