# Copy to .env and replace the placeholders. .env is not committed.
# SQLALCHEMY_DATABASE_URI is optional. When it is unset, config.py builds
# mysql+pymysql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/
# The value must end with / and must not include the schema name.
# database.py appends DATA_DB_NAME.

SECRET_KEY=change-me
SECURITY_PASSWORD_SALT=change-me
SECURITY_PASSWORD_HASH=argon2

DB_USER=iggybase
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
DATA_DB_NAME=iggybase
SEMANTIC_DB_NAME=

UPLOAD_FOLDER=/var/iggybase/uploads
FILE_FOLDER=/var/iggybase/files
ALLOWED_EXTENSIONS=pdf,csv,png,jpg,jpeg,gif,txt,xls,xlsx

MAIL_SERVER=
MAIL_PORT=25
MAIL_USE_TLS=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Optional Harvard accounting database. Leave both unset to skip it.
# SPINAL_DATABASE_URI=mysql+pymysql://user:change-me@host:3306/
# SPINAL_DB_NAME=spinal
